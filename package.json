{
  "name": "multi-agent-workbench",
  "version": "0.2.0",
  "description": "Run Claude Code, Codex and Antigravity CLIs in parallel git worktrees with task queues, dependencies, acceptance checks and a live status dashboard.",
  "type": "module",
  "bin": {
    "multi-agent-workbench": "bin/maw.mjs",
    "maw": "bin/maw.mjs"
  },
  "files": [
    "bin",
    "multi-agent-workbench",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/maw.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check bin/maw.mjs && for f in multi-agent-workbench/scripts/*.mjs; do node --check $f || exit 1; done",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruhul0/multi-agent-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/ruhul0/multi-agent-workbench/issues"
  },
  "homepage": "https://github.com/ruhul0/multi-agent-workbench#readme",
  "keywords": [
    "ai",
    "agents",
    "claude",
    "codex",
    "antigravity",
    "multi-agent",
    "git-worktree",
    "cli"
  ]
}
