{
  "name": "multi-agent-workbench",
  "version": "0.3.2",
  "description": "Plan work, split it into micro-tasks, and run Claude Code, Codex, Antigravity or any agent CLI in parallel git worktrees with retries, review/merge and a live dashboard.",
  "type": "module",
  "bin": {
    "multi-agent-workbench": "bin/maw.mjs",
    "maw": "bin/maw.mjs"
  },
  "files": [
    "bin",
    "skills",
    "tasks.schema.json",
    "examples",
    ".claude-plugin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/maw.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check bin/maw.mjs && for f in skills/multi-agent-workbench/scripts/*.mjs; do node --check $f || exit 1; done",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruhul0/multi-agent-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/ruhul0/multi-agent-workbench/issues"
  },
  "homepage": "https://github.com/ruhul0/multi-agent-workbench#readme",
  "keywords": [
    "agents",
    "ai",
    "antigravity",
    "claude",
    "claude-code-plugin",
    "cli",
    "codex",
    "dashboard",
    "git-worktree",
    "multi-agent",
    "task-queue",
    "worktree"
  ]
}
